---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import { platforms } from "../config/platforms";
import { siteUrl } from "../lib/urls";
import InteractiveWorkspaceDemo from "../components/home/InteractiveWorkspaceDemo.astro";
---
<WebsiteLayout title="Your AI workspace, agents and tools — connected" description="ImRabo brings AI assistants, autonomous agents, connected tools and workflows together in one extensible ecosystem." path="">
  <section class="relative isolate overflow-hidden bg-[#090b12] text-white">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -left-48 -top-48 h-[34rem] w-[34rem] rounded-full bg-blue-600/20 blur-[110px]"></div>
      <div class="absolute right-[-10rem] top-[-8rem] h-[38rem] w-[38rem] rounded-full bg-violet-600/20 blur-[130px]"></div>
      <div class="absolute bottom-[-18rem] left-1/3 h-[32rem] w-[32rem] rounded-full bg-cyan-500/10 blur-[120px]"></div>
      <div class="hero-grid absolute inset-0 opacity-30"></div>
    </div>
    <div class="mx-auto grid min-h-[720px] w-full max-w-7xl items-center gap-8 px-6 pb-20 pt-20 md:px-10 lg:grid-cols-[1.05fr_.95fr] lg:px-12 lg:pb-28 lg:pt-24">
      <div class="relative z-10 max-w-3xl">
        <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-xs font-semibold tracking-wide text-white/80 backdrop-blur"><span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,.8)]"></span>THE CONNECTED AI ECOSYSTEM <span class="ml-1 rounded-full bg-white/10 px-2 py-0.5 text-[10px] text-white/60">IMRABO</span></div>
        <h1 class="max-w-3xl text-5xl font-semibold leading-[1.04] tracking-[-0.055em] text-white sm:text-6xl md:text-7xl lg:text-[5.4rem]">One persistent memory. <span class="block text-white/55">Every AI model.</span> All your APIs.</h1>
        <p class="mt-8 max-w-xl text-base leading-8 text-white/65 md:text-lg">A personal AI workspace for multi-provider models, persistent context and connected tools. Delegate work, inspect every step and stay in control.</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={siteUrl("docs/getting-started/")} class="inline-flex items-center justify-center gap-3 rounded-full bg-white px-7 py-4 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-sky-100">Launch workspace <span>↗</span></a>
          <a href="https://github.com/imrabo" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-3 rounded-full border border-white/20 bg-white/[0.04] px-7 py-4 text-sm font-semibold text-white transition hover:bg-white/10">View architecture <span>→</span></a>
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-7 gap-y-3 text-xs font-medium text-white/45"><span>● Model agnostic</span><span>● Inspectable execution</span><span>● Human controlled actions</span></div>
      </div>
      <div class="relative mx-auto flex w-full items-center justify-center lg:min-h-[590px]">
        <div class="absolute -inset-8 rounded-full bg-sky-500/[.06] blur-3xl"></div>
        <InteractiveWorkspaceDemo />
      </div>
    </div>
    <div class="mx-auto max-w-7xl px-6 pb-10 md:px-10 lg:px-12"><div class="flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between"><span>One workspace for the way you work with AI.</span><a href="#ecosystem" class="inline-flex items-center gap-2 font-semibold text-white/65 hover:text-white">Discover the ecosystem ↓</a></div></div>
  </section>

  <section class="bg-background py-24 md:py-32" id="ecosystem">
    <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-end"><div><p class="eyebrow">A NEW WAY TO WORK WITH AI</p><h2 class="mt-5 max-w-xl text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl">From a single prompt to a complete workflow.</h2></div><p class="max-w-2xl text-base leading-8 text-muted-foreground lg:justify-self-end">ImRabo connects the pieces of an AI workflow. Start with a conversation, bring in the right tools, assign focused work to agents and keep the whole process understandable.</p></div>
      <div class="mt-14 grid gap-4 lg:grid-cols-12">
        <article class="feature-panel relative min-h-[390px] overflow-hidden rounded-3xl border border-border bg-[#101522] p-8 text-white lg:col-span-7 md:p-10"><div class="relative z-10 max-w-md"><span class="text-xs font-semibold uppercase tracking-[.2em] text-sky-300">01 / AI workspace</span><h3 class="mt-6 text-3xl font-semibold tracking-tight md:text-4xl">A workspace that understands your context.</h3><p class="mt-4 text-sm leading-7 text-white/60">Bring conversations, model choices, tools and working context together. Move from asking questions to getting meaningful work done.</p><a href={siteUrl("features/")} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-sky-300 hover:text-white">Explore the workspace →</a></div><div class="workspace-visual absolute -bottom-16 right-[-3rem] hidden w-[58%] rotate-[-5deg] rounded-2xl border border-white/15 bg-[#1b2333] p-4 shadow-2xl sm:block"><div class="flex items-center gap-2 border-b border-white/10 pb-3"><span class="h-2 w-2 rounded-full bg-rose-400"></span><span class="h-2 w-2 rounded-full bg-amber-300"></span><span class="h-2 w-2 rounded-full bg-emerald-400"></span><span class="ml-2 text-[10px] text-white/40">ImRabo workspace</span></div><div class="mt-5 flex gap-3"><div class="h-32 w-10 rounded-lg bg-white/5"></div><div class="flex-1 space-y-3"><div class="h-3 w-2/3 rounded bg-white/15"></div><div class="h-3 w-full rounded bg-white/10"></div><div class="h-3 w-4/5 rounded bg-white/10"></div><div class="mt-6 rounded-xl border border-sky-400/20 bg-sky-400/10 p-4"><div class="h-2 w-1/3 rounded bg-sky-300/60"></div><div class="mt-3 h-2 w-full rounded bg-white/10"></div><div class="mt-2 h-2 w-4/5 rounded bg-white/10"></div></div></div></div></div></article>
        <article class="feature-panel relative min-h-[390px] overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-violet-950 via-[#21183c] to-[#111322] p-8 text-white lg:col-span-5 md:p-10"><span class="text-xs font-semibold uppercase tracking-[.2em] text-violet-300">02 / Autonomous agents</span><h3 class="mt-6 max-w-sm text-3xl font-semibold tracking-tight">Give the work to agents. Keep the direction.</h3><p class="mt-4 max-w-sm text-sm leading-7 text-white/60">Coordinate a main agent and focused sub-agents for research, coding, analysis and execution.</p><div class="agent-orbit absolute -bottom-16 -right-10 h-64 w-64 rounded-full border border-violet-300/20"><div class="absolute left-1/2 top-[-15px] grid h-12 w-12 -translate-x-1/2 place-items-center rounded-2xl border border-violet-200/30 bg-violet-400/20 text-xl">✳</div><div class="absolute bottom-8 left-[-18px] grid h-10 w-10 place-items-center rounded-xl border border-white/15 bg-white/10">⌘</div><div class="absolute bottom-8 right-[-18px] grid h-10 w-10 place-items-center rounded-xl border border-white/15 bg-white/10">⌁</div></div></article>
        <article class="feature-panel relative min-h-[330px] overflow-hidden rounded-3xl border border-border bg-[#eef4ff] p-8 text-slate-950 dark:bg-[#131d30] dark:text-white lg:col-span-5 md:p-10"><span class="text-xs font-semibold uppercase tracking-[.2em] text-blue-600 dark:text-blue-300">03 / Connected tools</span><h3 class="mt-6 max-w-sm text-3xl font-semibold tracking-tight">Your tools. Your models. Your way.</h3><p class="mt-4 max-w-sm text-sm leading-7 text-slate-600 dark:text-white/55">Connect services and APIs through an extensible integration layer. Keep your workflow adaptable.</p><div class="mt-8 flex flex-wrap gap-2"><span class="rounded-xl border border-blue-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-white">MCP</span><span class="rounded-xl border border-blue-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-white">APIs</span><span class="rounded-xl border border-blue-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-white">Connectors</span></div></article>
        <article class="feature-panel relative min-h-[330px] overflow-hidden rounded-3xl border border-border bg-[#f4f0e9] p-8 text-slate-950 dark:bg-[#1c1b1a] dark:text-white lg:col-span-7 md:p-10"><div class="relative z-10 max-w-md"><span class="text-xs font-semibold uppercase tracking-[.2em] text-orange-700 dark:text-orange-300">04 / Computer and browser workflows</span><h3 class="mt-6 text-3xl font-semibold tracking-tight">Let AI work across the digital workspace.</h3><p class="mt-4 text-sm leading-7 text-slate-600 dark:text-white/55">A direction for research, browser-based tasks and multi-step workflows, with clear visibility into what an agent is doing.</p><a href={siteUrl("features/")} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-orange-700 dark:text-orange-300">See product direction →</a></div><div class="absolute bottom-[-2rem] right-[-2rem] hidden w-[45%] rotate-3 rounded-2xl border border-black/10 bg-white p-4 shadow-xl dark:border-white/10 dark:bg-[#282725] sm:block"><div class="flex items-center gap-2 border-b border-black/10 pb-3 dark:border-white/10"><span class="h-2 w-2 rounded-full bg-red-400"></span><span class="h-2 w-2 rounded-full bg-amber-400"></span><span class="h-2 w-2 rounded-full bg-green-400"></span><span class="ml-auto text-[10px] text-slate-400">Browser task</span></div><div class="mt-4 space-y-3"><div class="h-3 w-3/4 rounded bg-slate-200 dark:bg-white/10"></div><div class="h-20 rounded-xl bg-gradient-to-br from-orange-100 to-amber-50 dark:from-orange-400/20 dark:to-amber-300/10"></div><div class="h-2 w-full rounded bg-slate-100 dark:bg-white/10"></div><div class="h-2 w-2/3 rounded bg-slate-100 dark:bg-white/10"></div></div></div></article>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-muted/30 py-24 md:py-28"><div class="mx-auto grid max-w-7xl gap-14 px-6 md:px-10 lg:grid-cols-[.8fr_1.2fr] lg:px-12"><div><p class="eyebrow">HOW IT COMES TOGETHER</p><h2 class="mt-5 text-4xl font-semibold tracking-tight text-foreground md:text-5xl">One task.<br/>A coordinated team.</h2><p class="mt-6 max-w-md text-base leading-8 text-muted-foreground">The goal is not to add more AI interfaces. It is to make the work between them feel connected, observable and manageable.</p><a href={siteUrl("docs/")} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">Read the documentation →</a></div>
    <div class="rounded-3xl border border-border bg-card p-5 shadow-sm md:p-8"><div class="flex items-center justify-between border-b border-border pb-5"><div><p class="text-sm font-semibold text-foreground">Example workflow</p><p class="mt-1 text-xs text-muted-foreground">A coordinated task lifecycle</p></div><span class="rounded-full bg-emerald-500/10 px-3 py-1 text-[10px] font-semibold text-emerald-600 dark:text-emerald-300">Illustrative</span></div><div class="mt-7 space-y-5">
      <div class="flex gap-4"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-300">01</span><div class="flex-1"><h3 class="text-sm font-semibold text-foreground">You set the goal</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">Describe the outcome, constraints and context.</p></div><span class="self-center text-xs text-muted-foreground">Input</span></div><div class="ml-5 h-5 border-l border-dashed border-border"></div>
      <div class="flex gap-4"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-violet-500/10 text-violet-600 dark:text-violet-300">02</span><div class="flex-1"><h3 class="text-sm font-semibold text-foreground">The main agent plans</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">Break the goal into steps and identify the right capabilities.</p></div><span class="self-center text-xs text-muted-foreground">Plan</span></div><div class="ml-5 h-5 border-l border-dashed border-border"></div>
      <div class="flex gap-4"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-cyan-500/10 text-cyan-700 dark:text-cyan-300">03</span><div class="flex-1"><h3 class="text-sm font-semibold text-foreground">Agents and tools do focused work</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">Delegate tasks, use connected tools and collect results.</p></div><span class="self-center text-xs text-muted-foreground">Work</span></div><div class="ml-5 h-5 border-l border-dashed border-border"></div>
      <div class="flex gap-4"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-emerald-500/10 text-emerald-700 dark:text-emerald-300">04</span><div class="flex-1"><h3 class="text-sm font-semibold text-foreground">You review the outcome</h3><p class="mt-1 text-sm leading-6 text-muted-foreground">Inspect progress, outputs and decisions before moving forward.</p></div><span class="self-center text-xs text-muted-foreground">Review</span></div>
    </div></div></div></section>


  <section class="border-y border-white/10 bg-[#0B0D10] py-24 text-white md:py-28" id="workspace-architecture">
    <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl"><p class="font-mono text-[10px] font-semibold uppercase tracking-[.22em] text-emerald-300">THE THREE-PANE WORKSPACE</p><h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">Context, conversation and execution. In one view.</h2><p class="mt-5 max-w-2xl text-sm leading-7 text-white/55">Separate persistent project context from the active conversation and the workbench where agents, tools and approvals are inspected.</p></div>
      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        <article class="rounded-2xl border border-white/10 bg-white/[.025] p-6"><span class="font-mono text-[10px] text-emerald-300">01 / LEFT RAIL</span><h3 class="mt-5 text-xl font-semibold">Persistent context</h3><p class="mt-3 text-sm leading-7 text-white/55">Projects, pinned instructions, memory sources and reusable context. Inspect what is retained and control what belongs in each workspace.</p><div class="mt-6 space-y-2 rounded-xl border border-white/10 bg-black/20 p-4 font-mono text-[10px] text-white/55"><p>▤ &nbsp; Projects</p><p>◈ &nbsp; Memory nodes</p><p>⌑ &nbsp; Master instructions</p><p class="text-emerald-200">● &nbsp; Source visibility</p></div></article>
        <article class="rounded-2xl border border-white/10 bg-white/[.025] p-6"><span class="font-mono text-[10px] text-sky-300">02 / CENTER</span><h3 class="mt-5 text-xl font-semibold">Model-agnostic stream</h3><p class="mt-3 text-sm leading-7 text-white/55">A focused conversation with provider and model attribution at each step. Switch models without losing the thread or its project context.</p><div class="mt-6 space-y-3 rounded-xl border border-white/10 bg-black/20 p-4"><div class="ml-auto w-3/4 rounded-lg bg-white/10 p-3 text-[10px] text-white/65">Compare the API migration options.</div><div class="rounded-lg border border-white/10 p-3"><p class="font-mono text-[8px] text-sky-200">ANTHROPIC · MODEL STEP</p><p class="mt-2 text-[10px] leading-5 text-white/65">Evaluating compatibility and breaking changes…</p></div></div></article>
        <article class="rounded-2xl border border-white/10 bg-white/[.025] p-6"><span class="font-mono text-[10px] text-amber-200">03 / RIGHT INSPECTOR</span><h3 class="mt-5 text-xl font-semibold">Rabo's workbench</h3><p class="mt-3 text-sm leading-7 text-white/55">Task lineage, agent handoffs, API/MCP inputs and outputs, memory reads and writes, and explicit approval gates for sensitive actions.</p><div class="mt-6 space-y-2 rounded-xl border border-white/10 bg-black/20 p-4 font-mono text-[9px]"><p class="text-white/45">TOOL TRACE / 03 STEPS</p><p class="text-emerald-200">✓ memory.search</p><p class="text-emerald-200">✓ github.get_file</p><p class="text-amber-200">! github.create_issue · approval</p></div></article>
      </div>
    </div>
  </section>


  <section class="bg-background py-24 md:py-28" id="ambient-workflows">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 md:px-10 lg:grid-cols-[1fr_1fr] lg:px-12">
      <div><p class="eyebrow">LOW-FRICTION INVOCATION</p><h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl">Bring the agent to the work. Not the other way around.</h2><p class="mt-5 max-w-xl text-sm leading-7 text-muted-foreground">A future ambient layer can make ImRabo available through a keyboard shortcut, compact overlay or connected communication surface. Keep quick actions lightweight; open the full workspace when a task needs context or supervision.</p>
        <div class="mt-7 flex flex-wrap gap-2"><span class="rounded-full border border-border px-3 py-2 font-mono text-[10px] text-muted-foreground">⌘ K · QUICK INVOKE</span><span class="rounded-full border border-border px-3 py-2 font-mono text-[10px] text-muted-foreground">DESKTOP OVERLAY</span><span class="rounded-full border border-border px-3 py-2 font-mono text-[10px] text-muted-foreground">MOBILE / CHAT OPS</span></div>
      </div>
      <div class="rounded-3xl border border-border bg-card p-5 shadow-sm md:p-7">
        <div class="flex items-center justify-between border-b border-border pb-4"><div><p class="font-mono text-[9px] uppercase tracking-wider text-muted-foreground">Quick invoke · concept</p><p class="mt-1 text-sm font-semibold text-foreground">Ask Rabo</p></div><span class="rounded-full border border-emerald-500/20 bg-emerald-500/5 px-2.5 py-1 font-mono text-[9px] text-emerald-700 dark:text-emerald-300">READY</span></div>
        <div class="mt-5 rounded-xl border border-border bg-muted/40 p-4"><p class="text-sm text-muted-foreground">Summarize this page and save the key points to my project…</p><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-md bg-card px-2.5 py-1.5 text-[9px] text-muted-foreground">Summarize</span><span class="rounded-md bg-card px-2.5 py-1.5 text-[9px] text-muted-foreground">Find source</span><span class="rounded-md bg-card px-2.5 py-1.5 text-[9px] text-muted-foreground">Create task</span></div></div>
        <div class="mt-4 flex items-center justify-between gap-3"><p class="text-[10px] leading-5 text-muted-foreground">Actions inherit workspace permissions and approval policies.</p><span class="rounded-lg bg-foreground px-3 py-2 text-[10px] font-semibold text-background">Open workspace ↗</span></div>
      </div>
    </div>
  </section>

  <section class="bg-background py-24 md:py-28" id="trust-and-control">
    <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl"><p class="eyebrow">YOUR CONTEXT. YOUR KEYS. YOUR RULES.</p><h2 class="mt-5 text-4xl font-semibold tracking-tight text-foreground md:text-5xl">Trust is a product feature, not a footer link.</h2><p class="mt-5 text-sm leading-7 text-muted-foreground">The architecture should make data boundaries, permissions and portability understandable before a user connects personal services.</p></div>
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border border-border bg-card p-6"><span class="font-mono text-[10px] text-primary">01 / MEMORY SOVEREIGNTY</span><h3 class="mt-5 text-xl font-semibold text-foreground">Inspect and manage memory</h3><p class="mt-3 text-sm leading-7 text-muted-foreground">Show where each memory came from, which workspace can access it, and controls to edit, export or delete retained context. Local-first and encryption claims must match the shipped implementation.</p></article>
        <article class="rounded-2xl border border-border bg-card p-6"><span class="font-mono text-[10px] text-primary">02 / ACTION POLICIES</span><h3 class="mt-5 text-xl font-semibold text-foreground">Choose when agents can act</h3><p class="mt-3 text-sm leading-7 text-muted-foreground">Use policy levels for each tool or action: automatic for trusted read-only work, pre-approved for bounded operations, and ask first for external writes or sensitive changes.</p><div class="mt-5 space-y-2 font-mono text-[9px]"><p class="rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-3 py-2 text-emerald-700 dark:text-emerald-300">● AUTO-RUN · ALLOWED SCOPE</p><p class="rounded-lg border border-sky-500/20 bg-sky-500/5 px-3 py-2 text-sky-700 dark:text-sky-300">● PRE-APPROVED · BOUNDED</p><p class="rounded-lg border border-amber-500/20 bg-amber-500/5 px-3 py-2 text-amber-700 dark:text-amber-300">● ASK FIRST · EXTERNAL WRITE</p></div></article>
        <article class="rounded-2xl border border-border bg-card p-6"><span class="font-mono text-[10px] text-primary">03 / ZERO LOCK-IN</span><h3 class="mt-5 text-xl font-semibold text-foreground">One context layer, many models</h3><p class="mt-3 text-sm leading-7 text-muted-foreground">Keep the orchestration and context layer independent from model vendors. Route work to OpenAI, Anthropic, Google or local models through supported adapters.</p><div class="mt-5 flex flex-wrap items-center gap-2 font-mono text-[9px]"><span class="rounded border border-border px-2 py-1">MEMORY</span><span class="text-muted-foreground">→</span><span class="rounded border border-border px-2 py-1">ROUTER</span><span class="text-muted-foreground">→</span><span class="rounded border border-border px-2 py-1">MODEL APIs</span></div></article>
      </div>
      <div class="mt-5 rounded-2xl border border-border bg-muted/30 p-5 text-xs leading-6 text-muted-foreground"><strong class="text-foreground">Implementation transparency:</strong> These are design principles and intended controls. Do not interpret the illustrations as proof that all storage, encryption, export or permission features are currently available. Refer to product documentation for shipped behavior.</div>
    </div>
  </section>

  <section class="border-y border-border bg-muted/25 py-24 md:py-28" id="agent-lifecycle">
    <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl"><p class="eyebrow">ALWAYS-ON WORK, MADE VISIBLE</p><h2 class="mt-5 text-4xl font-semibold tracking-tight text-foreground md:text-5xl">Every task has a lifecycle.</h2><p class="mt-5 text-sm leading-7 text-muted-foreground">Background and scheduled work should remain discoverable without keeping a chat open. Separate current execution from future runs and completed history.</p></div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="rounded-2xl border border-border bg-card p-6"><p class="font-mono text-[10px] text-sky-600 dark:text-sky-300">IN PROGRESS</p><h3 class="mt-4 text-xl font-semibold text-foreground">Active work</h3><p class="mt-3 text-sm leading-7 text-muted-foreground">Current agent, current step, elapsed time, delegated workers and live tool trace.</p><div class="mt-6 h-1.5 overflow-hidden rounded-full bg-muted"><div class="h-full w-2/3 rounded-full bg-sky-500"></div></div><p class="mt-2 font-mono text-[9px] text-muted-foreground">Illustrative progress</p></article>
        <article class="rounded-2xl border border-border bg-card p-6"><p class="font-mono text-[10px] text-amber-600 dark:text-amber-300">SCHEDULED</p><h3 class="mt-4 text-xl font-semibold text-foreground">Future runs</h3><p class="mt-3 text-sm leading-7 text-muted-foreground">Recurring jobs, next run time, trigger conditions, configured action policy and pause controls.</p><div class="mt-6 rounded-lg border border-border p-3 font-mono text-[9px] text-muted-foreground">NEXT RUN · MON 09:00</div></article>
        <article class="rounded-2xl border border-border bg-card p-6"><p class="font-mono text-[10px] text-emerald-600 dark:text-emerald-300">COMPLETED</p><h3 class="mt-4 text-xl font-semibold text-foreground">Run history</h3><p class="mt-3 text-sm leading-7 text-muted-foreground">Final output, sources, token/cost usage, retries, approvals and a reproducible execution record.</p><div class="mt-6 rounded-lg border border-border p-3 font-mono text-[9px] text-muted-foreground">LAST RUN · SUCCESS</div></article>
