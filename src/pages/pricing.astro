---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import { siteUrl } from "../lib/urls";

const providers = [
  { name: "ChatGPT", individual: "Free; Plus $20/mo; Pro from $100/mo", team: "Business and Enterprise", strength: "General assistant, reasoning, research and agent features", url: "https://chatgpt.com/pricing/" },
  { name: "Claude", individual: "Free; Pro $20/mo ($17/mo effective with annual billing); Max from $100/mo", team: "Team and Enterprise plans", strength: "Writing, coding, analysis and extended work sessions", url: "https://claude.com/pricing" },
  { name: "Perplexity", individual: "Free; Pro $20/mo", team: "Enterprise Pro $34/seat/mo billed annually", strength: "Web research, cited answers and multi-model search", url: "https://www.perplexity.ai/enterprise/pricing" },
  { name: "Manus", individual: "Free tier documented; Pro starts at $20/mo", team: "Team starts at $20/seat/mo in Help Center", strength: "Autonomous task execution, research and content creation", url: "https://help.manus.im/en/articles/11711111-what-is-the-current-membership-pricing-for-manus" }
];
const comparisonRows = [
  ["Bring your own model-provider API key", "Yes", "Provider billing separate", "Provider billing separate", "Provider billing separate"],
  ["Choose from multiple model providers", "Core approach", "Provider-dependent", "Provider-dependent", "Model selection available"],
  ["Personal AI workspace", "Yes", "Yes", "Yes", "Yes"],
  ["Autonomous task workflows", "Product direction", "Features vary by plan", "Features vary by plan", "Core product capability"],
  ["Shared team workspace", "Planned", "Business plan", "Team plan", "Team plan"],
  ["Organization-level governance", "Enterprise scope to be agreed", "Enterprise", "Enterprise", "Team / Enterprise scope"],
  ["ImRabo connector and agent ecosystem", "Core focus", "Provider ecosystem", "Connected apps and tools", "Agent task environment"]
];
---
<WebsiteLayout title="ImRabo Pricing — Free BYOK, Solo, Team and Enterprise" description="Compare ImRabo's Free with BYOK, Solo, Team and Enterprise plans, and review public pricing from leading AI providers." path="pricing/">
  <div class="space-y-20 pb-20">
    <section class="bg-[#0b0c0e] px-5 pb-20 pt-16 text-white md:pb-24 md:pt-20">
      <div class="mx-auto max-w-6xl">
        <div class="text-center">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[.24em] text-[#7898b8]">IMRABO PLANS</p>
          <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white md:text-5xl">Pricing</h1>
          <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-[#9aa2ab] md:text-base">A connected AI workspace that scales from personal use to your whole team.</p>
          <a href={siteUrl("contact/")} class="mt-6 inline-flex rounded-full bg-[#292b2e] px-7 py-3 text-sm font-medium text-white transition hover:bg-[#35383c]">Contact sales</a>
        </div>
        <div class="mt-10 flex justify-center">
          <div class="pricing-switch inline-flex" role="group" aria-label="Choose pricing audience">
            <button type="button" data-pricing-tab="individual" aria-pressed="true" class="rounded-full px-6 py-2 text-xs font-semibold text-white transition">Individual</button>
            <button type="button" data-pricing-tab="teams" aria-pressed="false" class="rounded-full px-6 py-2 text-xs font-semibold text-[#8f98a2] transition">Teams</button>
          </div>
        </div>
        <div class="mt-4 grid gap-4 md:grid-cols-3" data-pricing-cards>
          {[
            { key: "free", audience: "both", name: "Free with BYOK", price: "$0", cadence: "No ImRabo subscription", description: "Bring your own model-provider API keys and pay providers directly for usage.", features: ["Personal AI workspace", "Choose supported models and providers", "Available tools and connectors", "No ImRabo subscription fee"], action: "Get started", href: "docs/getting-started/", note: "Provider API usage is billed separately." },
            { key: "solo", audience: "individual", name: "Solo", price: "Coming soon", cadence: "Individual plan", description: "A managed, ready-to-use AI workspace for personal productivity.", features: ["Personal AI workspace", "Agent and workflow capabilities", "Managed usage allowance (TBA)", "Personal settings and history"], action: "Explore Solo", href: "pricing/", note: "Price and included usage will be announced before launch." },
            { key: "enterprise-individual", audience: "individual", name: "Enterprise", price: "Custom", cadence: "Contract-based", description: "A tailored deployment for advanced security, governance and organizational needs.", features: ["Identity and access requirements", "Governance assessment", "Deployment and integration review", "Commercial discussion"], action: "Contact sales", href: "contact/", note: "Scope and commitments agreed individually." },
            { key: "team", audience: "teams", name: "Team", price: "Coming soon", cadence: "Per-seat plan", description: "Shared workspaces and coordinated AI workflows for teams.", features: ["Team workspace and members", "Shared agents and workflows", "Shared connector configuration", "Usage visibility and team controls"], action: "Explore Team", href: "pricing/", note: "Seat pricing and minimum seats are TBA." },
            { key: "enterprise-team", audience: "teams", name: "Enterprise", price: "Custom", cadence: "Contract-based", description: "A tailored deployment for advanced security, governance and organizational needs.", features: ["Identity and access requirements", "Governance assessment", "Deployment and integration review", "Commercial discussion"], action: "Contact sales", href: "contact/", note: "Scope and commitments agreed individually." }
          ].filter((plan) => plan.audience === "both" || plan.audience === "individual" || plan.audience === "teams").map((plan) => (
            <article data-plan-card data-audience={plan.audience} class:list={["pricing-plan-card flex flex-col p-7 md:p-8"]}>
              <p class="text-sm font-medium text-[#8da6bf]">{plan.name}</p>
              <div class="mt-5 flex items-baseline gap-2"><span class="text-4xl font-semibold tracking-tight text-white">{plan.price}</span>{plan.price === "$0" && <span class="text-xs text-[#929ba5]">/ month</span>}</div>
              <p class="mt-1 text-xs text-[#929ba5]">{plan.cadence}</p>
              <p class="mt-5 min-h-[72px] text-sm leading-6 text-[#a0a7af]">{plan.description}</p>
              <a href={siteUrl(plan.href)} class="mt-5 inline-flex w-full justify-center rounded-full bg-white px-5 py-3 text-sm font-medium text-[#111315] transition hover:bg-[#dce7f1]">{plan.action}</a>
              <p class="mt-7 text-xs font-semibold text-white">Includes:</p>
              <ul class="mt-3 flex-1 space-y-2.5 text-sm leading-6 text-[#929ba5]">{plan.features.map((feature) => <li class="flex gap-2.5"><span class="text-[#7898b8]">✓</span><span>{feature}</span></li>)}</ul>
              <p class="mt-6 border-t border-white/10 pt-4 text-xs leading-5 text-[#858e98]">{plan.note}</p>
            </article>
          ))}
        </div>
        <div class="mt-4 flex flex-col gap-4 rounded-[1.35rem] bg-[#191a1c] p-5 md:flex-row md:items-center md:justify-between md:px-7">
          <div class="flex items-start gap-3"><span class="mt-0.5 text-lg text-[#aabed2]">✳</span><p class="text-sm leading-6 text-white"><strong>Already using your own AI provider plan?</strong> <span class="text-[#929ba5]">Connect a supported API key and use it with ImRabo. Provider subscriptions and API billing are separate.</span></p></div>
          <a href={siteUrl("docs/getting-started/")} class="inline-flex shrink-0 justify-center rounded-full border border-white/20 px-5 py-2.5 text-xs font-semibold text-white transition hover:bg-white/10">Get started</a>
        </div>
        <p class="mt-5 text-center text-[11px] leading-5 text-[#737d87]">Solo and Team are planned tiers and are not currently purchasable. Enterprise scope is agreed individually. No unannounced prices or usage allowances are implied.</p>
      </div>
    </section>
    <script>
      const pricingRoot = document.querySelector("[data-pricing-cards]")?.parentElement;
      if (pricingRoot) {
        const tabs = Array.from(pricingRoot.querySelectorAll<HTMLButtonElement>("[data-pricing-tab]"));
        const cards = Array.from(pricingRoot.querySelectorAll<HTMLElement>("[data-plan-card]"));
        const selectAudience = (audience: string) => {
          tabs.forEach((tab) => {
            const active = tab.dataset.pricingTab === audience;
            tab.setAttribute("aria-pressed", String(active));
            tab.className = active ? "rounded-full px-6 py-2 text-xs font-semibold text-white transition" : "rounded-full px-6 py-2 text-xs font-semibold text-[#8f98a2] transition";
          });
          cards.forEach((card) => {
            const show = card.dataset.audience === "both" || card.dataset.audience === audience;
            card.classList.toggle("hidden", !show);
          });
        };
        tabs.forEach((tab) => tab.addEventListener("click", () => selectAudience(tab.dataset.pricingTab ?? "individual")));
        selectAudience("individual");
      }
    </script>

    <section class="border-y border-border bg-muted/25 py-20" id="provider-comparison">
      <div class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
        <div class="max-w-3xl"><p class="eyebrow">MARKET REFERENCE</p><h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">How other AI providers price their products</h2><p class="mt-4 text-sm leading-7 text-muted-foreground">A reference for individual and team subscriptions. These products are not identical to ImRabo: some sell access to a hosted assistant, while ImRabo's BYOK option is a workspace layer that uses provider API accounts you supply.</p></div>
        <div class="mt-10 overflow-x-auto rounded-2xl border border-border bg-card">
          <table class="w-full min-w-[820px] border-collapse text-left text-sm">
            <thead><tr class="border-b border-border bg-muted/60"><th class="px-5 py-4 font-semibold text-foreground">Provider</th><th class="px-5 py-4 font-semibold text-foreground">Individual reference</th><th class="px-5 py-4 font-semibold text-foreground">Team / business</th><th class="px-5 py-4 font-semibold text-foreground">Primary positioning</th></tr></thead>
            <tbody>{providers.map((provider) => <tr class="border-b border-border last:border-0 align-top"><td class="px-5 py-5 font-semibold text-foreground"><a href={provider.url} target="_blank" rel="noreferrer" class="hover:text-primary">{provider.name} ↗</a></td><td class="px-5 py-5 leading-6 text-muted-foreground">{provider.individual}</td><td class="px-5 py-5 leading-6 text-muted-foreground">{provider.team}</td><td class="px-5 py-5 leading-6 text-muted-foreground">{provider.strength}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="mt-4 text-xs leading-6 text-muted-foreground">USD reference prices from vendor-published pages and help documentation. Regional pricing, promotions, billing cadence and taxes can change the amount charged. Verify the linked provider page before purchase. Enterprise prices may require sales contact.</p>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <article class="rounded-2xl border border-border bg-card p-6"><h3 class="font-semibold text-card-foreground">Subscription pricing</h3><p class="mt-2 text-sm leading-7 text-muted-foreground">A provider subscription generally bundles access to that provider's own app, models and usage limits. It does not automatically pay for API calls made by external apps.</p></article>
          <article class="rounded-2xl border border-border bg-card p-6"><h3 class="font-semibold text-card-foreground">API / BYOK pricing</h3><p class="mt-2 text-sm leading-7 text-muted-foreground">API usage is normally billed separately by model, input/output tokens, tools or other metered resources. A consumer subscription and an API account should not be treated as interchangeable.</p></article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="max-w-3xl"><p class="eyebrow">CAPABILITY COMPARISON</p><h2 class="mt-4 text-3xl font-semibold tracking-tight text-foreground md:text-4xl">Compare the product approaches</h2><p class="mt-4 text-sm leading-7 text-muted-foreground">A qualitative overview, not a feature-by-feature guarantee. Availability varies by vendor plan and region. Planned ImRabo capabilities are labelled accordingly.</p></div>
      <div class="mt-9 overflow-x-auto rounded-2xl border border-border bg-card">
        <table class="w-full min-w-[760px] border-collapse text-left text-sm">
          <thead><tr class="border-b border-border bg-muted/60"><th class="px-5 py-4 font-semibold text-foreground">Capability</th><th class="px-5 py-4 font-semibold text-foreground">ImRabo</th><th class="px-5 py-4 font-semibold text-foreground">ChatGPT</th><th class="px-5 py-4 font-semibold text-foreground">Claude</th><th class="px-5 py-4 font-semibold text-foreground">Perplexity / Manus</th></tr></thead>
          <tbody>{comparisonRows.map((row) => <tr class="border-b border-border last:border-0 align-top"><th class="px-5 py-4 font-medium text-foreground">{row[0]}</th>{row.slice(1).map((cell) => <td class="px-5 py-4 leading-6 text-muted-foreground">{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-6 text-muted-foreground">Provider capabilities, entitlements and feature names change frequently. Use official pricing pages for exact plan entitlements.</p>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="rounded-3xl bg-[#090b12] px-7 py-12 text-white md:px-12 md:py-16"><p class="text-xs font-bold uppercase tracking-[.2em] text-sky-300">NOT SURE WHICH PLAN FITS?</p><div class="mt-5 grid gap-8 md:grid-cols-[1fr_auto] md:items-end"><div><h2 class="max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">Start with BYOK. Upgrade when collaboration or managed usage matters.</h2><p class="mt-5 max-w-2xl text-sm leading-7 text-white/60">Try the workspace with your own provider account, then choose a paid tier when its published limits and features match your needs.</p></div><a href={siteUrl("docs/getting-started/")} class="inline-flex w-fit rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-950 hover:bg-sky-100">Get started →</a></div></div>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <h2 class="text-2xl font-semibold text-foreground">Pricing questions</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-border p-6"><h3 class="font-semibold text-foreground">Does Free with BYOK include free AI tokens?</h3><p class="mt-2 text-sm leading-7 text-muted-foreground">No. The ImRabo workspace has no subscription fee, but the model provider charges you for API usage under its own pricing and terms.</p></article>
        <article class="rounded-2xl border border-border p-6"><h3 class="font-semibold text-foreground">Can I use a ChatGPT or Claude subscription as an API key?</h3><p class="mt-2 text-sm leading-7 text-muted-foreground">Generally no. Consumer subscriptions and developer API billing are separate products. Use a supported provider API key and check that provider's documentation.</p></article>
        <article class="rounded-2xl border border-border p-6"><h3 class="font-semibold text-foreground">When will Solo and Team prices be available?</h3><p class="mt-2 text-sm leading-7 text-muted-foreground">Their price, usage allowance, billing cadence and included features will be published when finalized. They are not currently offered for purchase.</p></article>
        <article class="rounded-2xl border border-border p-6"><h3 class="font-semibold text-foreground">Can an organization discuss Enterprise requirements?</h3><p class="mt-2 text-sm leading-7 text-muted-foreground">Yes. Contact the project team to discuss requirements. Enterprise features and commercial terms must be agreed rather than assumed from this overview.</p></article>
      </div>
    </section>
  </div>
</WebsiteLayout>
