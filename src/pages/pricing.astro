---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import { siteUrl } from "../lib/urls";

const pricingFactors = [
  {
    title: "Included capabilities",
    description: "Features, tools and platform access included with each plan.",
  },
  {
    title: "Usage limits",
    description:
      "Documented quotas, usage restrictions and fair-use conditions.",
  },
  {
    title: "Billing terms",
    description:
      "Billing interval, applicable taxes, payment terms and cancellation conditions.",
  },
  {
    title: "Support",
    description:
      "Available support channels, response commitments and service limitations.",
  },
];
---

<WebsiteLayout
  title="Pricing"
  description="Pricing and subscription information for ImRabo."
  path="pricing/"
>
  <div class="space-y-14">
    <section class="border-b border-border bg-muted/30">
      <div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-20 lg:px-12">
        <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary">
          IMRABO PRICING
        </p>

        <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl">
          Pricing should be clear before you commit
          <span class="text-primary">.</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-8 text-muted-foreground md:text-lg">
          Verified public plan prices and subscription details have not been
          provided in the current ImRabo website content. We will publish
          pricing information alongside the actual product capabilities and
          billing terms.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="rounded-xl border border-border bg-card p-7 md:p-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted px-3 py-1.5 text-xs font-semibold text-muted-foreground">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          PRICING DETAILS PENDING
        </div>

        <h2 class="mt-6 text-2xl font-bold text-foreground md:text-3xl">
          Public pricing information is being prepared.
        </h2>

        <p class="mt-4 max-w-2xl text-sm leading-7 text-muted-foreground">
          We do not want to publish speculative prices, incomplete plan
          comparisons or unclear billing conditions. Pricing should represent
          the actual product and the terms under which it is offered.
        </p>

        <a
          href={siteUrl("contact/")}
          class="mt-7 inline-flex items-center justify-center rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Contact the project team →
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">
        PRICING TRANSPARENCY
      </p>

      <h2 class="mt-3 text-2xl font-bold text-foreground">
        What every plan should explain.
      </h2>

      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
        Before publishing subscription plans, these details should be available
        for users to evaluate.
      </p>

      <div class="mt-7 grid gap-5 sm:grid-cols-2">
        {pricingFactors.map((factor, index) => (
          <article class="rounded-xl border border-border bg-card p-6">
            <span class="text-xs font-semibold text-primary">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3 class="mt-4 font-semibold text-foreground">{factor.title}</h3>

            <p class="mt-2 text-sm leading-7 text-muted-foreground">
              {factor.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl border-t border-border px-6 pt-8 md:px-10 lg:px-12">
      <p class="text-sm leading-7 text-muted-foreground">
        Any future pricing page should identify the currency, applicable taxes,
        renewal terms and cancellation policy clearly.
      </p>
    </section>
  </div>
</WebsiteLayout>
