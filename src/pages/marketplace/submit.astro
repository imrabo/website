---
import MarketplaceLayout from "../../layouts/MarketplaceLayout.astro";
import { siteUrl } from "../../lib/urls";

const submissionDetails = [
  {
    title: "Basic information",
    fields: ["Listing name", "Short description", "Category", "Publisher name"],
  },
  {
    title: "Technical information",
    fields: [
      "Source repository URL",
      "Current version",
      "Supported platforms",
      "Compatibility",
    ],
  },
  {
    title: "Security and permissions",
    fields: [
      "Required permissions",
      "Data accessed",
      "Authentication requirements",
      "Known limitations",
    ],
  },
  {
    title: "Documentation and support",
    fields: [
      "Installation guide",
      "License",
      "Support contact",
      "Maintenance information",
    ],
  },
];
---

<MarketplaceLayout
  title="Submit a listing"
  description="Contribute connectors, plugins and integrations to the ImRabo ecosystem."
>
  <div class="space-y-14">
    <!-- Introduction -->
    <section class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">
        COMMUNITY CONTRIBUTIONS
      </p>

      <h2 class="mt-4 text-3xl font-bold tracking-tight text-foreground">
        Build. Document. Contribute.
      </h2>

      <p class="mt-5 text-base leading-8 text-muted-foreground">
        ImRabo aims to build an ecosystem where developers and publishers can
        contribute integrations and extensions that make the platform more
        useful.
      </p>

      <p class="mt-3 text-base leading-8 text-muted-foreground">
        We are currently using a GitHub-based contribution approach. This
        website is static and does not directly accept, authenticate or store
        marketplace submissions.
      </p>
    </section>

    <!-- Current Process -->
    <section class="rounded-xl border border-border bg-muted/30 p-6 md:p-9">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          CURRENT PROCESS
        </span>
        <span class="text-xs text-muted-foreground">
          GitHub-based proposals
        </span>
      </div>

      <h2 class="mt-4 text-2xl font-bold text-foreground">
        How to propose a listing
      </h2>

      <div class="mt-8 grid gap-7 md:grid-cols-3">
        {[
          {
            number: "01",
            title: "Prepare",
            description:
              "Build your integration and prepare its documentation, source code and listing details.",
          },
          {
            number: "02",
            title: "Propose",
            description:
              "Share your proposal with the maintainers through the relevant public ImRabo GitHub repository.",
          },
          {
            number: "03",
            title: "Review",
            description:
              "The maintainers can evaluate the proposal, its functionality, permissions and documentation before publication.",
          },
        ].map((step) => (
          <div>
            <span class="text-sm font-bold text-primary">{step.number}</span>
            <h3 class="mt-3 text-lg font-semibold text-foreground">
              {step.title}
            </h3>
            <p class="mt-2 text-sm leading-7 text-muted-foreground">
              {step.description}
            </p>
          </div>
        ))}
      </div>

      <a
        href="https://github.com/imrabo"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-9 inline-flex items-center justify-center rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Visit ImRabo on GitHub ↗
      </a>
    </section>

    <!-- Required Information -->
    <section>
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          PROPOSAL CHECKLIST
        </p>

        <h2 class="mt-3 text-2xl font-bold text-foreground">
          Information to prepare
        </h2>

        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          Include the following information in your proposal so that maintainers
          can evaluate the listing.
        </p>
      </div>

      <div class="mt-7 grid gap-5 sm:grid-cols-2">
        {submissionDetails.map((group, index) => (
          <div class="rounded-xl border border-border bg-card p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary/10 text-xs font-bold text-primary">
                {String(index + 1).padStart(2, "0")}
              </span>

              <h3 class="font-semibold text-foreground">{group.title}</h3>
            </div>

            <ul class="mt-5 space-y-3">
              {group.fields.map((field) => (
                <li class="flex items-start gap-3 text-sm text-muted-foreground">
                  <span class="mt-0.5 text-primary" aria-hidden="true">
                    ✓
                  </span>
                  {field}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Important Notice -->
    <section class="rounded-xl border border-border bg-card p-6 md:p-8">
      <h2 class="text-lg font-semibold text-foreground">Before submitting</h2>

      <ul class="mt-5 space-y-3 text-sm leading-7 text-muted-foreground">
        <li>
          - Do not include API keys, credentials, passwords or other secrets in
          public repositories.
        </li>
        <li>
          - Clearly disclose data access, requested permissions and external
          dependencies.
        </li>
        <li>
          - Make sure you have the rights to distribute the submitted code and
          assets.
        </li>
        <li>
          - Do not describe an integration as verified or officially supported
          until the maintainers confirm it.
        </li>
      </ul>
    </section>

    <!-- Back to Marketplace -->
    <section class="flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-semibold text-foreground">Explore the marketplace</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Return to the ImRabo ecosystem directory.
        </p>
      </div>

      <a
        href={siteUrl("marketplace/")}
        class="text-sm font-semibold text-primary hover:underline"
      >
        Back to marketplace →
      </a>
    </section>
  </div>
</MarketplaceLayout>
