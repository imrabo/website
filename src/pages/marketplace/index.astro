---
import MarketplaceLayout from "../../layouts/MarketplaceLayout.astro";
import { siteUrl } from "../../lib/urls";

const categories = [
  {
    number: "01",
    title: "Connectors",
    description:
      "Integrations that connect ImRabo with external services, platforms and data sources.",
    href: siteUrl("marketplace/connectors/"),
    action: "Explore connectors",
    status: "Directory in development",
  },
  {
    number: "02",
    title: "Plugins",
    description:
      "Extensions that add capabilities and expand what users can do with ImRabo.",
    href: siteUrl("marketplace/plugins/"),
    action: "Explore plugins",
    status: "Directory in development",
  },
];
---

<MarketplaceLayout
  title="Marketplace"
  description="Explore the ecosystem of integrations, connectors and extensions built around ImRabo."
>
  <div class="space-y-16">
    <!-- Introduction -->
    <section class="max-w-3xl">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-muted px-3 py-1.5 text-xs font-semibold text-muted-foreground">
        <span class="h-2 w-2 rounded-full bg-primary"></span>
        EARLY ECOSYSTEM
      </div>

      <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
        Extend what ImRabo can do.
      </h2>

      <p class="mt-5 text-base leading-8 text-muted-foreground">
        The ImRabo Marketplace is designed to bring integrations, extensions and
        community-built capabilities into one discoverable ecosystem.
      </p>

      <p class="mt-3 text-base leading-8 text-muted-foreground">
        We are establishing listing standards before publishing integrations.
        Every public listing should have a verifiable publisher, source
        repository, version, permissions documentation and maintenance
        information.
      </p>
    </section>

    <!-- Categories -->
    <section>
      <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary">
            Explore categories
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground">
            Browse the ecosystem
          </h2>
        </div>

        <p class="text-sm text-muted-foreground">
          Public verified listings are not available yet.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {categories.map((category) => (
          <a
            href={category.href}
            class="group rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/40 hover:bg-accent/40 md:p-8"
          >
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-primary">
                {category.number}
              </span>
              <span class="text-xl text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-primary">
                →
              </span>
            </div>

            <h3 class="mt-8 text-2xl font-bold text-foreground">
              {category.title}
            </h3>

            <p class="mt-3 min-h-14 text-sm leading-7 text-muted-foreground">
              {category.description}
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
              <span class="text-xs text-muted-foreground">
                {category.status}
              </span>
              <span class="text-sm font-semibold text-primary">
                {category.action} →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Listing Standards -->
    <section class="rounded-xl border border-border bg-muted/30 p-6 md:p-9">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          Listing standards
        </p>

        <h2 class="mt-3 text-2xl font-bold tracking-tight text-foreground">
          Trust before discovery.
        </h2>

        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          Listings should provide enough information for users to understand
          what they are installing, who maintains it and what access it
          requires.
        </p>
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["Publisher identity", "A verifiable individual or organization."],
          [
            "Source repository",
            "A publicly accessible source code repository.",
          ],
          ["Version information", "Release version and compatibility details."],
          ["Permissions", "Clear disclosure of requested access and data."],
          [
            "Setup instructions",
            "Installation and configuration documentation.",
          ],
          ["Maintenance", "Support contact and maintenance status."],
        ].map(([heading, detail]) => (
          <div class="border-l-2 border-primary/40 pl-4">
            <h3 class="text-sm font-semibold text-foreground">{heading}</h3>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">{detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Contribution CTA -->
    <section class="flex flex-col gap-6 rounded-xl border border-border bg-card p-6 md:flex-row md:items-center md:justify-between md:p-9">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-foreground">
          Build something for the ecosystem.
        </h2>
        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          Explore the current contribution process and prepare an integration
          proposal for the ImRabo ecosystem.
        </p>
      </div>

      <a
        href={siteUrl("marketplace/submit/")}
        class="inline-flex shrink-0 items-center justify-center rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Propose a listing →
      </a>
    </section>
  </div>
</MarketplaceLayout>
