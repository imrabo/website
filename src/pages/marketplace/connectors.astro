---
import MarketplaceLayout from "../../layouts/MarketplaceLayout.astro";
import { siteUrl } from "../../lib/urls";

const requirements = [
  {
    title: "Service information",
    description:
      "The external service, its purpose and supported functionality.",
  },
  {
    title: "Access and permissions",
    description: "What information the connector can read, write or modify.",
  },
  {
    title: "Authentication",
    description:
      "Supported authentication method and configuration requirements.",
  },
  {
    title: "Setup instructions",
    description: "Installation, configuration and connection steps.",
  },
  {
    title: "Publisher and source",
    description: "Verified publisher identity and a source repository.",
  },
  {
    title: "Compatibility",
    description: "Supported ImRabo versions and connector release information.",
  },
];
---

<MarketplaceLayout
  title="Connectors"
  description="Discover integrations designed to connect ImRabo with external services and platforms."
>
  <div class="space-y-12">
    <!-- Introduction -->
    <section class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">
        MARKETPLACE / CONNECTORS
      </p>

      <h2 class="mt-4 text-3xl font-bold tracking-tight text-foreground">
        Connect your existing tools.
      </h2>

      <p class="mt-4 text-base leading-8 text-muted-foreground">
        Connectors are intended to bridge ImRabo with external services, APIs
        and platforms. Each integration should clearly document its
        functionality, data access and setup requirements.
      </p>
    </section>

    <!-- Empty State -->
    <section class="rounded-xl border border-dashed border-border bg-muted/20 px-6 py-12 text-center md:py-16">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl border border-border bg-card text-2xl text-primary">
        ↔
      </div>

      <p class="mt-6 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
        DIRECTORY STATUS
      </p>

      <h2 class="mt-3 text-2xl font-bold text-foreground">
        No verified connectors published yet.
      </h2>

      <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-muted-foreground">
        We are establishing the publishing and verification standards for
        connector listings. This directory will display integrations once their
        publisher, repository, permissions and documentation can be verified.
      </p>

      <a
        href={siteUrl("marketplace/submit/")}
        class="mt-7 inline-flex items-center justify-center rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Propose a connector →
      </a>
    </section>

    <!-- Listing Requirements -->
    <section>
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          PUBLISHING REQUIREMENTS
        </p>

        <h2 class="mt-3 text-2xl font-bold text-foreground">
          What every connector listing should include
        </h2>

        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          These details help users evaluate an integration before connecting it
          to their workflows.
        </p>
      </div>

      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {requirements.map((item, index) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <span class="text-xs font-semibold text-primary">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3 class="mt-4 font-semibold text-foreground">{item.title}</h3>

            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Navigation -->
    <section class="flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-semibold text-foreground">Looking for extensions?</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Explore the plugin directory.
        </p>
      </div>

      <a
        href={siteUrl("marketplace/plugins/")}
        class="text-sm font-semibold text-primary hover:underline"
      >
        Explore plugins →
      </a>
    </section>
  </div>
</MarketplaceLayout>
