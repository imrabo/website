---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import { siteUrl } from "../lib/urls";

const features = [
  {
    number: "01",
    title: "Connected tools",
    description:
      "Explore the project's direction toward connecting external tools, services and workflows.",
    details: [
      "External integrations",
      "Service connectivity",
      "Workflow connections",
    ],
    href: siteUrl("marketplace/connectors/"),
    action: "Explore connectors",
  },
  {
    number: "02",
    title: "Developer access",
    description:
      "Find package and developer resources where they are available, with compatibility and supported operations documented.",
    details: ["CLI resources", "Developer guides", "Technical references"],
    href: siteUrl("docs/"),
    action: "Explore documentation",
  },
  {
    number: "03",
    title: "Extensible ecosystem",
    description:
      "A marketplace structure intended to make extensions and community-built capabilities discoverable.",
    details: [
      "Connector directory",
      "Plugin directory",
      "Publisher information",
    ],
    href: siteUrl("marketplace/"),
    action: "Explore marketplace",
  },
  {
    number: "04",
    title: "Documentation-first",
    description:
      "Technical guides explain setup, constraints and expected behavior so developers can evaluate resources before use.",
    details: [
      "Installation guides",
      "Technical references",
      "Known limitations",
    ],
    href: siteUrl("docs/"),
    action: "Read documentation",
  },
  {
    number: "05",
    title: "Open development",
    description:
      "Public repositories provide a place to follow changes, report issues and contribute where repository permissions allow.",
    details: [
      "Public repositories",
      "Issue reporting",
      "Community contributions",
    ],
    href: "https://github.com/imrabo",
    external: true,
    action: "Visit GitHub",
  },
  {
    number: "06",
    title: "Platform clarity",
    description:
      "Platform pages distinguish released experiences from planned work and unconfirmed availability.",
    details: ["Web information", "Mobile information", "Desktop information"],
    href: siteUrl("platforms/"),
    action: "Explore platforms",
  },
];
---

<WebsiteLayout
  title="Features"
  description="Explore ImRabo's product direction, capability areas and documented resources."
  path="features/"
>
  <div class="space-y-16">
    <section class="border-b border-border bg-muted/30">
      <div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-24 lg:px-12">
        <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary">
          PRODUCT CAPABILITIES
        </p>

        <h1 class="max-w-4xl text-4xl font-bold leading-tight tracking-tight text-foreground md:text-6xl">
          Features and capabilities<span class="text-primary">.</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-8 text-muted-foreground md:text-lg">
          Explore the areas around which ImRabo is being organized: connected
          tools, developer resources, extensibility, documentation and platform
          access.
        </p>

        <p class="mt-4 max-w-2xl text-sm leading-7 text-muted-foreground">
          These areas describe the project's direction. A capability should be
          treated as available only when it is documented and supported by the
          relevant implementation.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="mb-9 max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          CAPABILITY AREAS
        </p>

        <h2 class="mt-3 text-2xl font-bold text-foreground md:text-3xl">
          Explore the ImRabo ecosystem.
        </h2>

        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          Each area links to the corresponding public resource or directory.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <article class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-colors hover:border-primary/40 hover:bg-accent/30">
            <span class="text-xs font-semibold tracking-widest text-primary">
              {feature.number}
            </span>

            <h3 class="mt-7 text-xl font-bold text-foreground">
              {feature.title}
            </h3>

            <p class="mt-3 flex-1 text-sm leading-7 text-muted-foreground">
              {feature.description}
            </p>

            <ul class="mt-6 space-y-2 border-t border-border pt-5">
              {feature.details.map((detail) => (
                <li class="flex gap-2 text-sm text-muted-foreground">
                  <span class="text-primary" aria-hidden="true">
                    ✓
                  </span>
                  {detail}
                </li>
              ))}
            </ul>

            <a
              href={feature.href}
              target={feature.external ? "_blank" : undefined}
              rel={feature.external ? "noopener noreferrer" : undefined}
              class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
            >
              {feature.action}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="rounded-xl border border-border bg-muted/30 p-7 md:p-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          PRODUCT TRANSPARENCY
        </p>

        <h2 class="mt-3 text-2xl font-bold text-foreground">
          Documented behavior, not assumptions.
        </h2>

        <p class="mt-4 max-w-3xl text-sm leading-7 text-muted-foreground">
          Product availability, integration support, platform compatibility and
          technical behavior should be verified against actual releases and
          documentation. Planned functionality is not a released feature.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl border-t border-border px-6 pt-8 md:px-10 lg:px-12">
      <a
        href={siteUrl("platforms/")}
        class="text-sm font-semibold text-primary hover:underline"
      >
        Explore ImRabo platforms →
      </a>
    </section>
  </div>
</WebsiteLayout>
