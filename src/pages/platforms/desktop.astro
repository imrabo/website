---
import WebsiteLayout from "../../layouts/WebsiteLayout.astro";
import { siteUrl } from "../../lib/urls";

const requirements = [
  {
    title: "Operating systems",
    description: "Supported Windows, macOS and Linux versions, if applicable.",
  },
  {
    title: "Distribution",
    description: "Verified installers and official download destinations.",
  },
  {
    title: "Code signing",
    description:
      "Publisher identity, signing information and package integrity.",
  },
  {
    title: "System requirements",
    description: "Minimum hardware, operating system and runtime requirements.",
  },
  {
    title: "Updates",
    description: "Release channels, update policy and version management.",
  },
  {
    title: "Release notes",
    description: "Version history, changes and known limitations.",
  },
];
---

<WebsiteLayout
  title="Desktop Platform"
  description="Explore desktop platform information and availability for ImRabo."
  path="platforms/desktop/"
>
  <div class="space-y-14">
    <!-- Hero -->
    <section class="border-b border-border bg-muted/30">
      <div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-20 lg:px-12">
        <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary">
          PLATFORM / DESKTOP
        </p>

        <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-foreground md:text-6xl">
          ImRabo on desktop<span class="text-primary">.</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-8 text-muted-foreground md:text-lg">
          Desktop platform information, distribution requirements and release
          documentation for the ImRabo ecosystem.
        </p>

        <div class="mt-7 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-muted-foreground">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          Availability not confirmed
        </div>
      </div>
    </section>

    <!-- Availability -->
    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="rounded-xl border border-border bg-card p-6 md:p-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary">
            DESKTOP AVAILABILITY
          </p>

          <h2 class="mt-4 text-2xl font-bold text-foreground">
            Desktop release information
          </h2>

          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            Public availability of an ImRabo desktop application has not been
            confirmed on this website. Official installers, supported operating
            systems and distribution information should be published only after
            a verified desktop release exists.
          </p>

          <p class="mt-3 text-sm leading-7 text-muted-foreground">
            No unofficial downloads or development builds should be treated as
            production releases.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-muted/30 p-6 md:p-8">
          <h2 class="text-lg font-bold text-foreground">Distribution status</h2>

          <div class="mt-6 space-y-5">
            {[
              ["Windows", "Unconfirmed"],
              ["macOS", "Unconfirmed"],
              ["Linux", "Unconfirmed"],
            ].map(([platform, status]) => (
              <div class="flex items-center justify-between gap-3 border-b border-border pb-4 last:border-0 last:pb-0">
                <span class="text-sm text-muted-foreground">{platform}</span>
                <span class="text-sm font-medium text-foreground">
                  {status}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Documentation Requirements -->
    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">
        DISTRIBUTION REQUIREMENTS
      </p>

      <h2 class="mt-3 text-2xl font-bold text-foreground">
        What a desktop release should include
      </h2>

      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
        Before publishing a desktop distribution, provide verified installation,
        compatibility, signing and update information.
      </p>

      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {requirements.map((item, index) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <span class="text-xs font-semibold text-primary">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3 class="mt-4 font-semibold text-foreground">{item.title}</h3>

            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Navigation -->
    <section class="flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-semibold text-foreground">Explore other platforms</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          View all ImRabo platform information.
        </p>
      </div>

      <a
        href={siteUrl("platforms/")}
        class="text-sm font-semibold text-primary hover:underline"
      >
        All platforms →
      </a>
    </section>
  </div>
</WebsiteLayout>
