---
import WebsiteLayout from "../../layouts/WebsiteLayout.astro";
import { siteUrl } from "../../lib/urls";

const requirements = [
  {
    title: "Operating systems",
    description: "Supported Android and iOS versions and device requirements.",
  },
  {
    title: "Distribution",
    description:
      "Verified Google Play and Apple App Store distribution links, if published.",
  },
  {
    title: "Permissions",
    description: "Device permissions, their purpose and related data access.",
  },
  {
    title: "Installation",
    description: "Official installation and update instructions.",
  },
  {
    title: "Compatibility",
    description:
      "Supported devices, known limitations and platform differences.",
  },
  {
    title: "Release notes",
    description: "Application versions, changes and important fixes.",
  },
];
---

<WebsiteLayout
  title="Mobile Platform"
  description="Explore mobile platform information and availability for ImRabo."
  path="platforms/mobile/"
>
  <div class="space-y-14">
    <!-- Hero -->
    <section class="border-b border-border bg-muted/30">
      <div class="mx-auto max-w-7xl px-6 py-16 md:px-10 md:py-20 lg:px-12">
        <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary">
          PLATFORM / MOBILE
        </p>

        <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-foreground md:text-6xl">
          ImRabo on mobile<span class="text-primary">.</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-8 text-muted-foreground md:text-lg">
          Mobile platform information, supported environments and distribution
          details for the ImRabo ecosystem.
        </p>

        <div class="mt-7 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-muted-foreground">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          Availability not confirmed
        </div>
      </div>
    </section>

    <!-- Availability -->
    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <div class="rounded-xl border border-border bg-card p-6 md:p-9">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary">
          MOBILE AVAILABILITY
        </p>

        <h2 class="mt-4 text-2xl font-bold text-foreground">
          Mobile release information
        </h2>

        <p class="mt-4 max-w-3xl text-sm leading-7 text-muted-foreground">
          Public availability of ImRabo mobile applications has not been
          confirmed on this website. Official store links, supported operating
          systems and installation instructions should only be published after a
          verified public release exists.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-border bg-muted/30 p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-semibold text-foreground">Android</h3>
              <span class="rounded-full border border-border bg-card px-3 py-1 text-xs text-muted-foreground">
                Unconfirmed
              </span>
            </div>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">
              Google Play listing, supported Android versions and installation
              details are to be confirmed.
            </p>
          </div>

          <div class="rounded-lg border border-border bg-muted/30 p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-semibold text-foreground">iOS</h3>
              <span class="rounded-full border border-border bg-card px-3 py-1 text-xs text-muted-foreground">
                Unconfirmed
              </span>
            </div>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">
              Apple App Store listing, supported iOS versions and installation
              details are to be confirmed.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Documentation Requirements -->
    <section class="mx-auto max-w-7xl px-6 md:px-10 lg:px-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">
        DOCUMENTATION REQUIREMENTS
      </p>

      <h2 class="mt-3 text-2xl font-bold text-foreground">
        Mobile platform information
      </h2>

      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted-foreground">
        A public mobile release should be accompanied by clear installation,
        compatibility and security information.
      </p>

      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {requirements.map((item, index) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <span class="text-xs font-semibold text-primary">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3 class="mt-4 font-semibold text-foreground">{item.title}</h3>

            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Navigation -->
    <section class="flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-semibold text-foreground">Explore other platforms</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          View all ImRabo platform information.
        </p>
      </div>

      <a
        href={siteUrl("platforms/")}
        class="text-sm font-semibold text-primary hover:underline"
      >
        All platforms →
      </a>
    </section>
  </div>
</WebsiteLayout>
