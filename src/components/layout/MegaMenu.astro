---
interface MenuLink {
  label: string;
  href: string;
  description?: string;
  external?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  links?: MenuLink[];
}

const {
  title = "Explore ImRabo",
  description = "Discover tools, resources and integrations for your workflow.",
  links = [],
} = Astro.props;
---

<section
  class="w-full rounded-xl border border-border bg-popover p-6 text-popover-foreground shadow-xl md:p-8"
  aria-label={`${title} menu`}
>
  <div class="mb-6 max-w-md">
    <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-primary">
      IMRABO ECOSYSTEM
    </p>

    <h2 class="text-xl font-bold tracking-tight text-foreground">{title}</h2>

    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
      {description}
    </p>
  </div>

  {links.length > 0 ? (
    <nav aria-label={`${title} links`}>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="group flex items-start justify-between gap-4 rounded-lg border border-transparent p-3 transition-colors hover:border-border hover:bg-accent"
          >
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-foreground transition-colors group-hover:text-primary">
                {link.label}
              </span>

              {link.description && (
                <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                  {link.description}
                </span>
              )}
            </span>

            <span
              class="shrink-0 text-sm text-muted-foreground transition-all group-hover:translate-x-1 group-hover:text-primary"
              aria-hidden="true"
            >
              {link.external ? "↗" : "→"}
            </span>
          </a>
        ))}
      </div>
    </nav>
  ) : (
    <p class="rounded-lg border border-dashed border-border px-4 py-6 text-center text-sm text-muted-foreground">
      No links available.
    </p>
  )}
</section>
