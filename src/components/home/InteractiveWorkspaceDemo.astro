const scenarios = [{"id":"memory","label":"Memory recall","prompt":"What did we decide about the connector rollout?","status":"Memory lookup","response":"The rollout plan prioritizes GitHub and Google connectors first, then adds provider-neutral search. The decision was to keep connector configuration portable.","source1":"Project notes · Connector rollout","source2":"Conversation · Architecture review","source3":"Workspace memory · 2 relevant items","agent1":"Search workspace memory","agent2":"Rank matching context","agent3":"Compose with citations","payload":"query: connector rollout\nlimit: 5\nworkspace: current","approval":"Read-only lookup · no approval needed","answer":"Two matching decisions found; original context linked for verification."},{"id":"tools","label":"API execution","prompt":"Create a draft issue for the failed connector test.","status":"Approval required","response":"I prepared an issue draft with the failing test name, expected behavior and reproduction steps. Nothing has been submitted yet.","source1":"Test run · connector CI","source2":"Repository · imrabo/connectors","source3":"Draft payload · GitHub issue","agent1":"Inspect CI failure","agent2":"Prepare issue content","agent3":"Wait for approval","payload":"repo: imrabo/connectors\ntitle: Connector test failure\naction: create (pending)","approval":"External write · user approval required","answer":"Review the draft and approve the write before the connector creates anything."},{"id":"routing","label":"Model routing","prompt":"Research this API change, then summarize implementation impact.","status":"Parallel research","response":"Research is split into source discovery and implementation analysis. Each worker reports its model, tools and evidence before final synthesis.","source1":"Official API documentation","source2":"Repository code search","source3":"Release notes · vendor","agent1":"Research agent · web","agent2":"Code agent · repository","agent3":"Main agent · synthesis","payload":"workers: 2\nstrategy: parallel\nmerge: evidence-first","approval":"Read-only research · no approval needed","answer":"The main agent combines both workstreams and keeps evidence attached to each finding."}];
---
<section class="workspace-demo relative z-10 w-full max-w-[660px] overflow-hidden rounded-[1.6rem] border border-white/15 bg-[#0B0D10] text-white shadow-[0_30px_100px_rgba(0,0,0,.48)]" data-workspace-demo>
  <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
    <div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-red-400/80"></span><span class="h-2 w-2 rounded-full bg-amber-300/80"></span><span class="h-2 w-2 rounded-full bg-emerald-400/80"></span><span class="ml-2 font-mono text-[10px] tracking-wide text-white/45">IMRABO / WORKSPACE PREVIEW</span></div>
    <span class="rounded-md border border-white/10 px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-white/45">Illustrative demo</span>
  </div>
  <div class="border-b border-white/10 px-4 py-3"><p class="mb-2 font-mono text-[9px] uppercase tracking-[.18em] text-white/40">Choose a workflow</p><div class="flex flex-wrap gap-2" role="group" aria-label="Workspace demo scenarios">
    {scenarios.map((scenario, index) => <button type="button" data-scenario={scenario.id} aria-pressed={index === 0 ? "true" : "false"} class:list={["rounded-lg border px-3 py-2 text-[11px] font-medium transition", index === 0 ? "border-white/35 bg-white/10 text-white" : "border-white/10 text-white/55 hover:border-white/25 hover:text-white"]}>{scenario.label}</button>)}
  </div></div>
  <div class="grid min-h-[370px] grid-cols-[112px_minmax(0,1fr)] sm:grid-cols-[132px_minmax(0,1fr)_174px]">
    <aside class="border-r border-white/10 bg-white/[.025] p-3"><p class="font-mono text-[9px] uppercase tracking-wider text-white/35">Workspace</p><div class="mt-4 space-y-1 text-[10px]"><div class="rounded-md bg-white/[.09] px-2 py-2 text-white">⌂ &nbsp; Overview</div><div class="rounded-md px-2 py-2 text-white/45">▤ &nbsp; Projects</div><div class="rounded-md px-2 py-2 text-white/45">◈ &nbsp; Memory</div><div class="rounded-md px-2 py-2 text-white/45">⌘ &nbsp; Agents</div></div><div class="mt-7 border-t border-white/10 pt-3"><p class="font-mono text-[9px] uppercase tracking-wider text-white/35">Master context</p><p class="mt-2 text-[10px] leading-4 text-white/55">Connector rollout<br/>API conventions<br/>Project decisions</p><span class="mt-3 inline-flex rounded border border-emerald-300/20 px-1.5 py-1 font-mono text-[8px] text-emerald-200/80">3 ITEMS PINNED</span></div></aside>
    <main class="min-w-0 p-3 sm:p-4"><div class="flex items-center justify-between gap-2"><div><p class="font-mono text-[9px] uppercase tracking-wider text-white/35">Current task</p><p class="mt-1 text-[11px] font-semibold text-white/90">Workspace assistant</p></div><span data-demo-status class="rounded-md border border-white/10 bg-white/[.06] px-2 py-1 font-mono text-[8px] text-white/75">{scenarios[0].status}</span></div>
      <div class="mt-5 flex justify-end"><div class="max-w-[92%] rounded-xl rounded-tr-sm border border-white/10 bg-white/[.07] px-3 py-2.5 text-[10px] leading-5 text-white/75" data-demo-prompt>{scenarios[0].prompt}</div></div>
      <div class="mt-4 flex gap-2"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-md border border-white/10 bg-white/[.06] font-mono text-[10px] text-white/75">R</span><div class="min-w-0"><p class="font-mono text-[9px] text-white/45">IMRABO · MAIN AGENT</p><p class="mt-2 text-[10px] leading-[1.8] text-white/75" data-demo-response>{scenarios[0].response}</p></div></div>
      <div class="mt-4 rounded-lg border border-white/10 bg-black/20 p-3"><div class="flex items-center justify-between"><p class="font-mono text-[9px] uppercase tracking-wider text-white/40">Evidence attached</p><span class="font-mono text-[8px] text-white/35">SOURCES FIRST</span></div><ul class="mt-2 space-y-2 text-[9px] text-white/65"><li class="flex gap-2"><span class="text-sky-300">↗</span><span data-demo-source1>{scenarios[0].source1}</span></li><li class="flex gap-2"><span class="text-sky-300">↗</span><span data-demo-source2>{scenarios[0].source2}</span></li><li class="flex gap-2"><span class="text-sky-300">↗</span><span data-demo-source3>{scenarios[0].source3}</span></li></ul></div>
      <div class="mt-4 flex items-center gap-2 rounded-lg border border-white/10 px-3 py-2"><span class="h-1.5 w-1.5 rounded-full bg-emerald-300"></span><span class="font-mono text-[8px] text-white/40">MODEL</span><span class="font-mono text-[9px] text-white/70">Provider selected for this step</span></div>
    </main>
    <aside class="col-span-2 border-t border-white/10 bg-white/[.025] p-3 sm:col-span-1 sm:border-l sm:border-t-0"><div class="flex items-center justify-between"><p class="font-mono text-[9px] uppercase tracking-wider text-white/40">Workbench</p><span class="font-mono text-[8px] text-white/35">TASK TRACE*</span></div>
      <div class="mt-3 space-y-3"><div class="flex gap-2"><span class="mt-0.5 h-4 w-4 shrink-0 rounded border border-sky-300/20 bg-sky-300/10 text-center font-mono text-[9px] text-sky-200">1</span><div><p class="text-[9px] text-white/75" data-demo-agent1>{scenarios[0].agent1}</p><p class="mt-0.5 font-mono text-[8px] text-white/35">COMPLETE</p></div></div><div class="flex gap-2"><span class="mt-0.5 h-4 w-4 shrink-0 rounded border border-sky-300/20 bg-sky-300/10 text-center font-mono text-[9px] text-sky-200">2</span><div><p class="text-[9px] text-white/75" data-demo-agent2>{scenarios[0].agent2}</p><p class="mt-0.5 font-mono text-[8px] text-white/35">COMPLETE</p></div></div><div class="flex gap-2"><span class="mt-0.5 h-4 w-4 shrink-0 rounded border border-sky-300/20 bg-sky-300/10 text-center font-mono text-[9px] text-sky-200">3</span><div><p class="text-[9px] text-white/75" data-demo-agent3>{scenarios[0].agent3}</p><p class="mt-0.5 font-mono text-[8px] text-white/35">COMPLETE</p></div></div></div>
      <div class="mt-4 rounded-lg border border-white/10 bg-black/20 p-2.5"><p class="font-mono text-[8px] uppercase tracking-wider text-white/40">Tool payload</p><p class="mt-2 whitespace-pre-line font-mono text-[8px] leading-4 text-white/65" data-demo-payload>{scenarios[0].payload}</p><p class="mt-3 border-t border-white/10 pt-2 text-[8px] leading-4 text-amber-200/80" data-demo-approval>{scenarios[0].approval}</p></div>
    </aside>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-white/10 px-4 py-3"><p class="text-[9px] text-white/35">* Simulated UI preview. No live provider, memory or API calls are made.</p><span class="font-mono text-[8px] text-white/40" data-demo-answer>{scenarios[0].answer}</span></div>
</section>
<script>
  const demo = document.querySelector<HTMLElement>("[data-workspace-demo]");
  if (demo) {
    const scenarios = [{"id":"memory","label":"Memory recall","prompt":"What did we decide about the connector rollout?","status":"Memory lookup","response":"The rollout plan prioritizes GitHub and Google connectors first, then adds provider-neutral search. The decision was to keep connector configuration portable.","source1":"Project notes · Connector rollout","source2":"Conversation · Architecture review","source3":"Workspace memory · 2 relevant items","agent1":"Search workspace memory","agent2":"Rank matching context","agent3":"Compose with citations","payload":"query: connector rollout\nlimit: 5\nworkspace: current","approval":"Read-only lookup · no approval needed","answer":"Two matching decisions found; original context linked for verification."},{"id":"tools","label":"API execution","prompt":"Create a draft issue for the failed connector test.","status":"Approval required","response":"I prepared an issue draft with the failing test name, expected behavior and reproduction steps. Nothing has been submitted yet.","source1":"Test run · connector CI","source2":"Repository · imrabo/connectors","source3":"Draft payload · GitHub issue","agent1":"Inspect CI failure","agent2":"Prepare issue content","agent3":"Wait for approval","payload":"repo: imrabo/connectors\ntitle: Connector test failure\naction: create (pending)","approval":"External write · user approval required","answer":"Review the draft and approve the write before the connector creates anything."},{"id":"routing","label":"Model routing","prompt":"Research this API change, then summarize implementation impact.","status":"Parallel research","response":"Research is split into source discovery and implementation analysis. Each worker reports its model, tools and evidence before final synthesis.","source1":"Official API documentation","source2":"Repository code search","source3":"Release notes · vendor","agent1":"Research agent · web","agent2":"Code agent · repository","agent3":"Main agent · synthesis","payload":"workers: 2\nstrategy: parallel\nmerge: evidence-first","approval":"Read-only research · no approval needed","answer":"The main agent combines both workstreams and keeps evidence attached to each finding."}];
    const fields = { status: "[data-demo-status]", prompt: "[data-demo-prompt]", response: "[data-demo-response]", source1: "[data-demo-source1]", source2: "[data-demo-source2]", source3: "[data-demo-source3]", agent1: "[data-demo-agent1]", agent2: "[data-demo-agent2]", agent3: "[data-demo-agent3]", payload: "[data-demo-payload]", approval: "[data-demo-approval]", answer: "[data-demo-answer]" };
    const buttons = Array.from(demo.querySelectorAll<HTMLButtonElement>("[data-scenario]"));
    const renderScenario = (id: string) => {
      const scenario = scenarios.find((item: {id: string}) => item.id === id);
      if (!scenario) return;
      for (const [key, selector] of Object.entries(fields)) {
        const element = demo.querySelector<HTMLElement>(selector);
        if (element) element.textContent = scenario[key as keyof typeof scenario] as string;
      }
      buttons.forEach((button) => {
        const active = button.dataset.scenario === id;
        button.setAttribute("aria-pressed", String(active));
        button.className = active ? "rounded-lg border border-white/35 bg-white/10 px-3 py-2 text-[11px] font-medium text-white transition" : "rounded-lg border border-white/10 px-3 py-2 text-[11px] font-medium text-white/55 transition hover:border-white/25 hover:text-white";
      });
    };
    buttons.forEach((button) => button.addEventListener("click", () => renderScenario(button.dataset.scenario ?? "")));
  }
</script>
